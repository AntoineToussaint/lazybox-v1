{
  "name": "@lazybox/v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "check:workspaces": "npm ls --workspaces --all",
    "typecheck": "tsc --noEmit",
    "build:web": "npm run build -w @lazybox/web",
    "dev:web": "npm run dev -w @lazybox/web",
    "build:worker": "tsc -p workers/claude-sdk",
    "test:browser": "node --import tsx scripts/test-browser.mjs",
    "test:client": "node --import tsx --test scripts/ansi.test.ts scripts/client-state.test.ts scripts/workspace-model.test.ts scripts/command-runs.test.ts scripts/transcript.test.ts scripts/repository-catalog.test.ts scripts/keyboard.test.ts scripts/actions.test.ts scripts/composer-vim.test.ts scripts/activity-replay.test.ts scripts/diagnostic-recording.test.ts scripts/attention.test.ts scripts/pull-request-model.test.ts scripts/processes-model.test.ts scripts/orchestration-process-model.test.ts scripts/runner-link.test.ts scripts/diagram.test.ts scripts/editor-model.test.ts scripts/chat-polish.test.ts scripts/subscription-switch.test.ts scripts/attachment-images.test.ts scripts/review-model.test.ts scripts/turn-checkpoints.test.ts scripts/workspace-runtime.test.ts scripts/remote-device.test.ts scripts/missions-model.test.ts scripts/artifact-model.test.ts scripts/subagents.test.ts scripts/live-bar.test.ts scripts/context-menu.test.ts scripts/tool-lines.test.ts scripts/workspace-row-model.test.ts scripts/onboarding-model.test.ts scripts/diff-layout.test.ts scripts/peek-model.test.ts",
    "test:worker": "node --import tsx --test workers/claude-sdk/src/*.test.ts",
    "test:startup": "node scripts/test-startup.mjs",
    "test:workspace": "node scripts/test-workspace.mjs",
    "test:command-console": "node scripts/test-command-console.mjs",
    "test:github": "node scripts/test-github.mjs",
    "test:attachments": "node scripts/test-attachments.mjs",
    "test:attachment-previews": "node scripts/test-attachment-previews.mjs",
    "test:settings": "node scripts/test-settings.mjs",
    "test:settings-approval": "node scripts/test-settings-approval.mjs",
    "test:empty-workspace": "node scripts/test-empty-workspace.mjs",
    "test:repositories": "node scripts/test-repository-discovery.mjs",
    "test:github-token": "node scripts/test-github-token.mjs",
    "test:repository-picker": "node scripts/test-unified-repositories.mjs",
    "test:dialogs": "node scripts/test-dialogs.mjs",
    "test:telemetry": "node scripts/test-telemetry.mjs",
    "test:agent-settings": "node scripts/test-agent-settings.mjs",
    "test:activity-review": "node --import tsx scripts/test-activity-review.mjs",
    "test:rich-activity": "node scripts/test-rich-activity.mjs",
    "test:workspace-actions": "node scripts/test-workspace-actions.mjs",
    "test:stabilization": "node scripts/test-stabilization.mjs",
    "test:editor-navigation": "node scripts/test-editor-navigation.mjs",
    "test:chat-scroll": "node scripts/test-chat-scroll.mjs",
    "test:sidebar-polish": "node scripts/test-sidebar-polish.mjs",
    "test:resume-continuity": "node scripts/test-resume-continuity.mjs",
    "test:unified-repositories": "node scripts/test-unified-repositories.mjs",
    "test:navigation-snippets": "node scripts/test-navigation-snippets.mjs",
    "test:vim-editing": "node scripts/test-vim-editing.mjs",
    "test:activity-presentation": "node scripts/test-activity-presentation.mjs",
    "test:dogfood": "node scripts/test-dogfood.mjs",
    "test:responsive-shell": "node scripts/test-responsive-shell.mjs",
    "test:terminal": "node scripts/test-terminal.mjs",
    "test:terminal-share": "node scripts/test-terminal-share.mjs",
    "test:runner-restart": "node scripts/test-runner-restart.mjs",
    "test:runner-follow": "node scripts/test-runner-follow.mjs",
    "test:inbox": "node scripts/test-inbox.mjs",
    "test:command-palette": "node scripts/test-command-palette.mjs",
    "test:pull-request": "node scripts/test-pull-request.mjs",
    "test:review-comments": "node scripts/test-review-comments.mjs",
    "test:processes": "node scripts/test-processes.mjs",
    "test:transcript-performance": "node scripts/test-transcript-performance.mjs",
    "test:mermaid-viewer": "node scripts/test-mermaid-viewer.mjs",
    "test:file-navigation": "node scripts/test-file-navigation.mjs",
    "test:prompt-navigation": "node scripts/test-prompt-navigation.mjs",
    "test:send-recovery": "node scripts/test-send-recovery.mjs",
    "test:chat-polish": "node scripts/test-chat-polish.mjs",
    "test:artifacts": "node scripts/test-artifacts.mjs",
    "test:subscription-switch": "node scripts/test-subscription-switch.mjs",
    "test:settings-polish": "node scripts/test-settings-polish.mjs",
    "screenshots:polish": "node scripts/polish-screenshots.mjs",
    "test:sidebar-width": "node scripts/test-sidebar-width.mjs",
    "test:editor-wrap": "node scripts/test-editor-wrap.mjs",
    "test:turn-checkpoints": "node scripts/test-turn-checkpoints.mjs",
    "test:workspace-runtime": "node scripts/test-workspace-runtime.mjs",
    "test:remote-pairing": "node scripts/test-remote-pairing.mjs",
    "test:remote-inbox": "node scripts/test-remote-inbox.mjs",
    "test:missions": "node scripts/test-missions.mjs",
    "test:subagents": "node scripts/test-subagents.mjs",
    "test:live-bar": "node scripts/test-live-bar.mjs",
    "test:context-menus": "node scripts/test-context-menus.mjs && node scripts/test-context-menus-live.mjs",
    "test:chat-decisions": "node scripts/test-chat-decisions.mjs",
    "test:workspace-rows": "node scripts/test-workspace-rows.mjs",
    "test:peek": "node scripts/test-peek.mjs",
    "test:onboarding": "node scripts/test-onboarding.mjs",
    "test:split-diff": "node scripts/test-split-diff.mjs"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
